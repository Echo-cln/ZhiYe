<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">
    <fragment android:id="@+id/homeFragment" android:name="com.echo.zhiye.ui.HomeFragment" android:label="首页"/>
    <fragment android:id="@+id/topicsFragment" android:name="com.echo.zhiye.ui.TopicsFragment" android:label="议题"/>
    <fragment android:id="@+id/sourcesFragment" android:name="com.echo.zhiye.ui.SourcesFragment" android:label="媒体"/>
    <fragment android:id="@+id/profileFragment" android:name="com.echo.zhiye.ui.ProfileFragment" android:label="我的"/>
    <fragment android:id="@+id/articleDetailFragment" android:name="com.echo.zhiye.ui.ArticleDetailFragment" android:label="新闻详情">
        <argument android:name="articleId" app:argType="string"/>
    </fragment>
    <fragment android:id="@+id/searchFragment" android:name="com.echo.zhiye.ui.SearchFragment" android:label="搜索">
        <argument android:name="topic" app:argType="string" android:defaultValue="全部"/>
        <argument android:name="source" app:argType="string" android:defaultValue="全部"/>
    </fragment>
    <fragment android:id="@+id/collectionFragment" android:name="com.echo.zhiye.ui.CollectionFragment" android:label="收藏与历史">
        <argument android:name="mode" app:argType="string" android:defaultValue="bookmarks"/>
    </fragment>
    <fragment android:id="@+id/localNewsFragment" android:name="com.echo.zhiye.ui.LocalNewsFragment" android:label="本地新闻管理"/>
    <fragment android:id="@+id/editorFragment" android:name="com.echo.zhiye.ui.EditorFragment" android:label="编辑新闻">
        <argument android:name="articleId" app:argType="string" android:defaultValue="@null" app:nullable="true"/>
    </fragment>
    <fragment android:id="@+id/settingsFragment" android:name="com.echo.zhiye.ui.SettingsFragment" android:label="设置"/>
    <fragment android:id="@+id/authFragment" android:name="com.echo.zhiye.ui.AuthFragment" android:label="登录与注册"/>
</navigation>
