<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/paper" android:padding="20dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:paddingEnd="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="知页"
                    android:textColor="@color/ink" android:textSize="34sp" android:fontFamily="serif" android:textStyle="bold"/>
                <TextView android:id="@+id/edition_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日版"
                    android:textColor="@color/secondary_ink" android:textSize="11sp"/>
            </LinearLayout>
            <ImageButton android:id="@+id/search_button" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_search" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="搜索" app:tint="@color/ink"/>
            <ImageButton android:id="@+id/refresh_button" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@android:drawable/ic_popup_sync" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="刷新" app:tint="@color/ink"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="把重要的事，读清楚。"
            android:layout_marginTop="12dp" android:textSize="16sp" android:fontFamily="serif" android:textColor="@color/ink"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/topic_chips" android:layout_width="wrap_content"
                android:layout_height="wrap_content" app:singleLine="true" app:singleSelection="true"/>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="媒体来源" android:textSize="12sp" android:textColor="@color/secondary_ink"/>
            <Spinner android:id="@+id/source_filter" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"/>
        </LinearLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe_refresh"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/news_recycler" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:clipToPadding="false"/>
                <TextView android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:gravity="center" android:visibility="gone"
                    android:text="暂时没有符合条件的新闻" android:textColor="@color/muted"/>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/rule"/>
    <ScrollView android:id="@+id/tablet_detail_pane" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:fillViewport="true" android:paddingStart="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="24dp">
            <TextView android:id="@+id/tablet_detail_source" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="选择一篇新闻" android:textColor="@color/accent" android:textSize="12sp"/>
            <TextView android:id="@+id/tablet_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="在左侧选择新闻，开始阅读" android:textColor="@color/ink" android:textSize="27sp"
                android:fontFamily="serif" android:textStyle="bold" android:layout_marginTop="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rule" android:layout_marginTop="18dp"/>
            <TextView android:id="@+id/tablet_detail_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/secondary_ink" android:textSize="16sp" android:lineSpacingExtra="6dp" android:layout_marginTop="18dp"/>
            <TextView android:id="@+id/tablet_detail_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/ink" android:textSize="15sp" android:lineSpacingExtra="7dp" android:layout_marginTop="18dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/tablet_open_detail"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="打开完整详情"
                android:layout_marginTop="20dp" app:backgroundTint="@color/ink"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
