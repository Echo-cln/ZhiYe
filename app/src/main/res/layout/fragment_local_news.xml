<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本地新闻管理"
            android:textColor="@color/ink" android:textSize="28sp" android:fontFamily="serif" android:textStyle="bold"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/local_news_list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="12dp"/>
    </LinearLayout>
    <TextView android:id="@+id/local_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center" android:text="还没有本地新闻，点击右下角添加" android:textColor="@color/muted"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/local_add"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="22dp" android:contentDescription="添加新闻" android:src="@android:drawable/ic_input_add" app:backgroundTint="@color/ink" app:tint="@color/surface_white"/>
</FrameLayout>
