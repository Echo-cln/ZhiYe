<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="编辑本地新闻"
            android:textColor="@color/ink" android:textSize="27sp" android:fontFamily="serif" android:textStyle="bold"/>
        <EditText android:id="@+id/editor_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="新闻标题" android:textSize="18sp" android:layout_marginTop="18dp"/>
        <EditText android:id="@+id/editor_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="摘要" android:minLines="2" android:gravity="top" android:layout_marginTop="10dp"/>
        <Spinner android:id="@+id/editor_topic" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/editor_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="正文或补充说明" android:minLines="7" android:gravity="top" android:layout_marginTop="10dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/editor_save" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="保存" android:layout_marginTop="18dp" app:backgroundTint="@color/ink"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/editor_delete" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="删除这条新闻" android:visibility="gone" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_marginTop="6dp"/>
    </LinearLayout>
</ScrollView>
