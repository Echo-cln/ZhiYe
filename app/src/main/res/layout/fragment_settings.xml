<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/paper" android:padding="22dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置"
        android:textColor="@color/ink" android:textSize="29sp" android:fontFamily="serif" android:textStyle="bold"/>
    <TextView android:id="@+id/settings_clear_history" android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:text="清空阅读历史" android:textColor="@color/ink" android:textSize="15sp" android:background="?attr/selectableItemBackground"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rule"/>
    <TextView android:id="@+id/settings_signout" android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:text="退出当前账户" android:textColor="@color/ink" android:textSize="15sp" android:background="?attr/selectableItemBackground"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rule"/>
    <TextView android:id="@+id/settings_about" android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:text="关于知页" android:textColor="@color/ink" android:textSize="15sp" android:background="?attr/selectableItemBackground"/>
</LinearLayout>
