<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
 android:layout_height="match_parent" android:background="@color/surface_white" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="阅读设置"
   android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/>
  <TextView android:id="@+id/settings_font_label" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="正文大小 · 16sp" android:textColor="@color/secondary_ink" android:textSize="13sp" android:layout_marginTop="24dp"/>
  <SeekBar android:id="@+id/settings_font_size" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:max="8" android:progress="2" android:layout_marginTop="8dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="较小" android:textColor="@color/muted" android:textSize="11sp"/>
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="较大" android:textColor="@color/muted" android:textSize="11sp"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="行间距"
   android:textColor="@color/secondary_ink" android:textSize="13sp" android:layout_marginTop="20dp"/>
  <Spinner android:id="@+id/settings_line_spacing" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp"/>
  <TextView android:id="@+id/settings_reader_preview" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="让阅读回到内容本身。在清晰的标题与适当的留白之间，找到适合自己的阅读节奏。"
   android:textColor="@color/ink" android:textSize="16sp" android:lineSpacingExtra="6dp" android:padding="16dp"
   android:background="@drawable/bg_reader_preview" android:layout_marginTop="18dp"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rule" android:layout_marginTop="24dp"/>
  <TextView android:id="@+id/settings_clear_history" android:layout_width="match_parent" android:layout_height="54dp"
   android:gravity="center_vertical" android:text="清空阅读历史" android:textColor="@color/ink" android:textSize="14sp" android:background="?attr/selectableItemBackground"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/soft_rule"/>
  <TextView android:id="@+id/settings_signout" android:layout_width="match_parent" android:layout_height="54dp"
   android:gravity="center_vertical" android:text="退出当前账户" android:textColor="@color/ink" android:textSize="14sp" android:background="?attr/selectableItemBackground"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/soft_rule"/>
  <TextView android:id="@+id/settings_about" android:layout_width="match_parent" android:layout_height="54dp"
   android:gravity="center_vertical" android:text="关于知页" android:textColor="@color/ink" android:textSize="14sp" android:background="?attr/selectableItemBackground"/>
 </LinearLayout>
</ScrollView>
