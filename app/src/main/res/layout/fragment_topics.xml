<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
 android:layout_height="match_parent" android:background="@color/surface_white">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
   <ImageButton android:id="@+id/topics_back" android:layout_width="40dp" android:layout_height="40dp"
    android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回"/>
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:text="全部议题" android:gravity="center" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold"/>
   <View android:layout_width="40dp" android:layout_height="40dp"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="从不同议题进入新闻，保持对世界的持续观察。"
   android:textColor="@color/secondary_ink" android:textSize="13sp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp"/>
  <LinearLayout android:id="@+id/topic_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 </LinearLayout>
</ScrollView>
