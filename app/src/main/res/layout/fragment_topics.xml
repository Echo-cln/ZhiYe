<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="议题"
            android:textColor="@color/ink" android:textSize="30sp" android:fontFamily="serif" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="从不同议题进入新闻，保持对世界的持续观察。"
            android:textColor="@color/secondary_ink" android:textSize="13sp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp"/>
        <LinearLayout android:id="@+id/topic_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
