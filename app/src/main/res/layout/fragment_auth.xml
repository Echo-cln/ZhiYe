<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_white">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
  <TextView android:id="@+id/auth_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="登录知页"
   android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="让每一次阅读，都有迹可循。"
   android:textColor="@color/secondary_ink" android:textSize="12sp" android:layout_marginTop="6dp"/>
  <EditText android:id="@+id/auth_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="昵称"
   android:textSize="14sp" android:visibility="gone" android:layout_marginTop="22dp"/>
  <EditText android:id="@+id/auth_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="邮箱"
   android:inputType="textEmailAddress" android:textSize="14sp" android:layout_marginTop="18dp"/>
  <EditText android:id="@+id/auth_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="密码（至少 6 位）"
   android:inputType="textPassword" android:textSize="14sp" android:layout_marginTop="8dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/auth_submit" android:layout_width="match_parent"
   android:layout_height="46dp" android:text="登录" android:layout_marginTop="18dp" app:backgroundTint="@color/accent"/>
  <TextView android:id="@+id/auth_toggle" android:layout_width="match_parent" android:layout_height="46dp"
   android:gravity="center" android:text="还没有账户？立即注册" android:textColor="@color/accent" android:textSize="12sp"/>
 </LinearLayout>
</ScrollView>
