<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_white">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
   <ImageButton android:id="@+id/sources_back" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_back"
    android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回"/>
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="媒体来源"
    android:gravity="center" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold"/>
   <View android:layout_width="40dp" android:layout_height="40dp"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="按媒体来源阅读，查看报道与数据接入方式。"
   android:textColor="@color/secondary_ink" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_marginBottom="14dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="国际媒体" android:textColor="@color/accent" android:textSize="12sp"/>
  <LinearLayout android:id="@+id/international_sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="国内媒体" android:textColor="@color/accent" android:textSize="12sp" android:layout_marginTop="14dp"/>
  <LinearLayout android:id="@+id/domestic_sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="财经媒体" android:textColor="@color/accent" android:textSize="12sp" android:layout_marginTop="14dp"/>
  <LinearLayout android:id="@+id/finance_sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 </LinearLayout>
</ScrollView>
