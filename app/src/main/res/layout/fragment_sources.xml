<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="媒体"
            android:textColor="@color/ink" android:textSize="30sp" android:fontFamily="serif" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="按媒体来源阅读，查看每个来源的数据接入方式。"
            android:textColor="@color/secondary_ink" android:textSize="13sp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="国际媒体" android:textColor="@color/accent" android:textSize="12sp"/>
        <LinearLayout android:id="@+id/international_sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="国内媒体" android:textColor="@color/accent" android:textSize="12sp" android:layout_marginTop="18dp"/>
        <LinearLayout android:id="@+id/domestic_sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="财经媒体" android:textColor="@color/accent" android:textSize="12sp" android:layout_marginTop="18dp"/>
        <LinearLayout android:id="@+id/finance_sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
