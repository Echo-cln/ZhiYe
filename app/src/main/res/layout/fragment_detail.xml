<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/detail_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@color/surface_white" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
  android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
   <ImageButton android:id="@+id/detail_back" android:layout_width="40dp" android:layout_height="40dp"
    android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回"/>
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:text="知页" android:textColor="@color/ink" android:textSize="18sp" android:gravity="center" android:textStyle="bold"/>
   <ImageButton android:id="@+id/detail_share" android:layout_width="40dp" android:layout_height="40dp"
    android:src="@drawable/ic_share" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="分享"/>
  </LinearLayout>
  <TextView android:id="@+id/detail_source" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="媒体 · 议题" android:textColor="@color/accent" android:textSize="12sp" android:layout_marginTop="10dp"/>
  <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="新闻标题" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"
   android:lineSpacingExtra="3dp" android:layout_marginTop="8dp"/>
  <TextView android:id="@+id/detail_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="发布时间" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="8dp"/>
  <TextView android:id="@+id/detail_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="阅读进度 · 0%" android:textColor="@color/accent" android:textSize="11sp" android:layout_marginTop="8dp"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rule" android:layout_marginTop="14dp"/>
  <ImageView android:id="@+id/detail_image" android:layout_width="match_parent" android:layout_height="200dp"
   android:scaleType="centerCrop" android:contentDescription="新闻图片" android:layout_marginTop="16dp"/>
  <TextView android:id="@+id/detail_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:textColor="@color/secondary_ink" android:textSize="15sp" android:lineSpacingExtra="6dp" android:layout_marginTop="16dp"/>
  <TextView android:id="@+id/detail_body" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:textColor="@color/ink" android:textSize="15sp" android:lineSpacingExtra="6dp" android:layout_marginTop="18dp"/>
  <TextView android:id="@+id/detail_notice" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingExtra="4dp" android:layout_marginTop="18dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
   android:gravity="center" android:layout_marginTop="20dp">
   <com.google.android.material.button.MaterialButton android:id="@+id/detail_bookmark" android:layout_width="0dp" android:layout_height="46dp"
    android:layout_weight="1" android:text="收藏" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/detail_original" android:layout_width="0dp" android:layout_height="46dp"
    android:layout_weight="1" android:text="阅读原文" android:layout_marginStart="10dp" app:backgroundTint="@color/accent"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
